# Copy to backend/.env and fill in. NEVER commit the real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://cyclecare:cyclecare@localhost:5432/cyclecare

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
# Used to hash client IPs in audit logs (never store raw IPs)
AUDIT_IP_SALT=change-me-too

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Grok (xAI). Server-side ONLY — never ship this to the mobile app.
# AI explanation layer (optional — the app works without it).
# xAI Grok (PRD default):   GROK_API_KEY=xai-...   GROK_MODEL=grok-4.7   GROK_BASE_URL=https://api.x.ai/v1
# Groq (auto for gsk_ keys): GROK_API_KEY=gsk_...   → defaults to https://api.groq.com/openai/v1 + openai/gpt-oss-120b
GROK_API_KEY=
GROK_MODEL=grok-4.7
GROK_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=30

CORS_ORIGINS=*
