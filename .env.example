# انسخي هذا الملف إلى .env  (محمي من git) ثم املأي القيم.
# الأفضلية دائمًا لمتغيرات البيئة الحقيقية على هذا الملف.
# يمكن تحديد مسار ملف آخر بـ ENV_FILE=/path/to/.env

# LLM
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b

# البلد: يحدّد رقم الطوارئ من app/data/emergency_numbers.json (23 بلدًا موثّقًا).
# إن لم يكن البلد مُدرجًا يُستخدم رقم عام مع تنبيه صريح أنه غير مُتحقق منه.
COUNTRY_CODE=EG

# أرقام الطوارئ
# اتركيه فارغًا/محذوفًا لاستخدام جدول البلد. أي قيمة هنا تُعدّ «ضبطًا صريحًا»
# وتتقدّم على الجدول لكل الطلبات، لذا لا تُضبط إلا إن كان التطبيق لبلد واحد.
# EMERGENCY_NUMBER=123
CRISIS_LINE=

# قاعدة البيانات المحلية (دورات وأعراض) — محمية من git
DB_PATH=data/cyclecare.db

# Prompt
PROMPT_VERSION=v1.3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200

# إعادة المحاولة عند 413/429 من المزوّد (بايثون: LLM_MAX_ATTEMPTS و LLM_RETRY_BACKOFF_SECONDS)
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_SECONDS=20
# إعادات محاولة مكتبة groq نفسها على 5xx (الافتراضي في المكتبة 2)
LLM_SDK_MAX_RETRIES=2

# RAG
RAG_TOP_K=5

# قاعدة المعرفة
# المسودات في app/data/sources_draft.json لا تُرسل للموديل افتراضيًا ولا تُستشهد بها.
# لا تُفعّلي هذا إلا لاختبار داخلي محكوم؛ أي مقطع غير مُراجَع طبيًا قد يصل للمستخدمة.
KNOWLEDGE_INCLUDE_DRAFTS=0
# DRAFT_SOURCES_PATH=app/data/sources_draft.json

# CORS — اتركيه فارغًا عندما تُخدم الواجهة من نفس التطبيق (الوضع الافتراضي).
# للسماح لأصل آخر: CORS_ALLOW_ORIGINS=https://app.example.com
# القيمة * تسمح لأي موقع باستخدام الـ API (غير آمن بدون مصادقة).
CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------------------
# الأمان — مطلوب قبل أي نشر حقيقي
# ---------------------------------------------------------------------------
# مفتاح الواجهة/الـ API. فارغ = مفتوح للجميع (للتطوير المحلي فقط).
# الطلبات التي يُفعّل فيها فلتر الطوارئ تُقبل دائمًا حتى لو كان المفتاح خاطئًا.
API_KEY=

# تحديد معدّل الطلبات (لا يُطبَّق على رسائل الطوارئ أبدًا)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------- اللغة والتعريب
DEFAULT_LOCALE=ar
SUPPORTED_LOCALES=ar,en
DEFAULT_TIMEZONE=Africa/Cairo
# الأرقام: western (0-9، الافتراضي) أو arabic_indic (٠-٩) — إعداد المستخدمة يتقدّم
DIGITS_STYLE=western
# أول أيام الأسبوع (الافتراضي السبت حسب البريف): saturday|sunday|monday|...
WEEK_START=saturday
# LOCALES_PATH=locales

# ------------------------------------------------- أرقام مصر (قابلة للتحقق)
# القيم أدناه من البريف المصري. حالة التحقق:
#   الإسعاف 123        — متحقّق منه (app/data/emergency_numbers.json)
#   الشرطة 122         — من البريف، يحتاج تأكيدًا رسميًا قبل الاعتماد
#   الموحّد 112        — ⚠️ غير مؤكَّد رسميًا؛ لا يُعرض كرقم موثوق
#   الصحة 105          — من البريف
#   الأطفال 16000      — من البريف
#   خط الأزمة 08008880700 — ⚠️ لا يُفعَّل حتى التأكد أنه يعمل؛ رقم ميت في لحظة
#                            أزمة أسوأ من عدم ذكره. عند التحقق: CRISIS_LINE=...
EMERGENCY_COUNTRY=EG
POLICE_NUMBER=122
UNIFIED_EMERGENCY=112
UNIFIED_EMERGENCY_VERIFIED=0
HEALTH_HOTLINE=105
CHILD_HELPLINE=16000
CRISIS_LINE=

# ------------------------------------------------------------ قاعدة المعرفة (KB)
# sqlite للتطوير المحلي | postgres للنشر (يتطلب migrations/001_kb_pgvector.sql)
KB_BACKEND=sqlite
KB_DB_PATH=data/kb.db
KB_SOURCE_REGISTRY=data/sources_registry.json
# 1 (الافتراضي): المقالات التثقيفية غير المراجَعة طبيًا مسموحة وتُعرض موسومة «غير مراجَعة».
# 0 = المعتمد فقط (صرامة كاملة).
KB_ALLOW_DRAFT=1
# تحميل بذرة kb/knowledge/knowledge_seed.jsonl كمسودات عند الإقلاع (آمن للتكرار)
KB_AUTOLOAD_SEED=1
# bge-m3 أو intfloat/multilingual-e5-large (قارني بالـeval قبل التثبيت)
KB_EMBEDDING_MODEL=BAAI/bge-m3
# local = محوّل حتمي بلا شبكة (اختبارات فقط) | sentence-transformers = الإنتاج
KB_EMBEDDING_BACKEND=local
KB_TOP_K=6
KB_MIN_SIMILARITY=0.30
KB_MIN_KEYWORD_SCORE=0.34
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# التدقيق
# AUDIT_LOG_PATH=audit/responses.jsonl
